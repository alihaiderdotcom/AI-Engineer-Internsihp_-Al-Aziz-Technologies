# Environment Variables for Week 4 LLM Applications
# Copy this file to .env and configure your API key

# OpenRouter / OpenAI compatible API key
OPENAI_API_KEY=your_openrouter_or_openai_api_key_here

# Google Gemini API key (optional alternative)
GEMINI_API_KEY=your_gemini_api_key_here

# Default Model Identifier
LLM_MODEL=liquid/lfm-2.5-2.6b:free

# Model Configuration Parameters
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=512
LLM_REQUEST_TIMEOUT=30
